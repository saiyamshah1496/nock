{
  "name": "@nockhq/action",
  "version": "0.1.0",
  "private": true,
  "description": "Nock GitHub Action wrapper",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true});}catch(_){}\" && ncc build src/index.ts -o dist -m",
    "build:dev": "tsc -b",
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true});}catch(_){}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@nockhq/core": "workspace:*",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.5.4"
  }
}

