name = "nock-api"
# Point Wrangler directly at TypeScript source; Wrangler will bundle to ESM.
main = "src/worker.ts"
compatibility_date = "2024-11-01"
# Enable Node.js compatibility for process.env and some builtins (fs is NOT available).
compatibility_flags = ["nodejs_compat"]

# Add non-secret vars here if desired (see docs for guidance).
[vars]
# NOCK_STATS_STORE = "r2" # or leave unset for file store in dev
# NOCK_DEV_PLAINTEXT_STATS = "1"

# Secrets: set via `wrangler secret put`
# - NOCK_STATS_API_TOKEN
# - NOCK_STATS_KEK
# - R2_ACCOUNT_ID
# - R2_ACCESS_KEY_ID
# - R2_SECRET_ACCESS_KEY
# - R2_BUCKET

