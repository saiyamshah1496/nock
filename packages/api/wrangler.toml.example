name = "nock-api"
# Point Wrangler directly at TypeScript source; Wrangler will bundle to ESM.
main = "src/worker.ts"
compatibility_date = "2024-11-01"
# Enable Node.js compatibility for process.env and some builtins (fs is NOT available).
compatibility_flags = ["nodejs_compat"]

# Add non-secret vars here if desired (see docs for guidance).
[vars]
# NOCK_ESTATE_STORE = "r2" # prefer; or leave unset for file store in dev (falls back to NOCK_STATS_STORE)
# NOCK_DEV_PLAINTEXT_ESTATE = "1" # prefer; falls back to NOCK_DEV_PLAINTEXT_STATS
# NOCK_AUDIT_RETENTION_DAYS = "30"

# Secrets: set via `wrangler secret put`
# - NOCK_ESTATE_API_TOKEN (falls back to NOCK_STATS_API_TOKEN)
# - NOCK_ESTATE_KEK (falls back to NOCK_STATS_KEK)
# - R2_ACCOUNT_ID
# - R2_ACCESS_KEY_ID
# - R2_SECRET_ACCESS_KEY
# - R2_BUCKET
# - GITHUB_WEBHOOK_SECRET
# - GITHUB_APP_ID
# - GITHUB_APP_PRIVATE_KEY

## D1 binding for org policy + audit (Team)
## Fill in `database_name` and `database_id` in your Cloudflare account.
## Do NOT commit real IDs/tokens to the repo.
[[d1_databases]]
binding = "NOCK_D1"
database_name = "nock-team"
## Placeholder only — set your real database_id in wrangler.toml (deploy path)
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "d1/migrations"

