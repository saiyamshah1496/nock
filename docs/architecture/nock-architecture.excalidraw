      "link": null,
      "locked": false,
      "text": "Path A: committed estate.json / paste\nPath B: nock sync-estate (customer DB, read-only role) → file\nPath B+: push encrypted estate to hosted API (Team)\nLive refresh: --database-url / MCP databaseUrl\n(client-side catalogue refresh, check-only; free path)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 216
